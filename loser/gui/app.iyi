# The main window's widgets: projects, tasks of the selected project, the selected task.
# Edits autosave 500 ms after the last change; status changes save at once.

module loser/gui/app

import github.com/tuntii/kilim
import github.com/tuntii/kilim/kilim/widget::{Widget}
import github.com/tuntii/kilim/kilim/box::{Box}
import github.com/tuntii/kilim/kilim/label::{Label}
import github.com/tuntii/kilim/kilim/textbox::{Textbox}
import github.com/tuntii/kilim/kilim/text_area::{TextArea}
import github.com/tuntii/kilim/kilim/list_view::{ListView, ListRow}
import github.com/tuntii/kilim/kilim/dropdown::{Dropdown}
import github.com/tuntii/kilim/kilim/window::{Window}
import loser/store::{Store}
import loser/task::{Task, STATUSES, status_title}
import loser/projects::{Project}

AUTOSAVE_MS = 500

# The text fields' on_change closures are built before the App is: they reach it through this.
class Hook
  property app : App? = nil

  def edited : Nil
    if a = @app
      a.edited
    end
  end
end

pub class App
  getter root : Widget
  property win : Window? = nil
  getter projects : ListView
  getter tasks : ListView
  getter search : Textbox
  getter title : Textbox
  getter title_ro : Label
  getter status : Dropdown
  getter labels : Textbox
  getter labels_ro : Label
  getter notes : TextArea
  getter status_line : Label
  getter no_task : Label
  # Edits not on disk yet (a failed save keeps them).
  getter dirty : Bool

  def initialize(@store : Store)
    hook = Hook.new
    on_edit = ->(_s : String) { hook.edited; nil }
    @project = nil.as(String?)
    @task = nil.as(String?)
    @dirty = false
    @timer = nil.as(Int32?)
    @projects = Kilim.list_view
    @tasks = Kilim.list_view
    @search = Kilim.textbox("Search", sizing: Kilim.fit)
    @title = Kilim.textbox("Title", on_change: on_edit)
    @title_ro = Kilim.label("")
    @status = Kilim.dropdown(STATUSES.map { |s| status_title(s) })
    @labels = Kilim.textbox("comma, separated", on_change: on_edit)
    @labels_ro = Kilim.label("")
    @notes = Kilim.text_area("Notes", on_change: on_edit)
    @status_line = Kilim.label("")
    @title_slot = Kilim.row([@title] of Widget)
    @labels_slot = Kilim.row([@labels] of Widget)
    # Task 9 wires these.
    left = Kilim.column([Kilim.label("Projects"), Kilim.scroll(@projects), Kilim.button("New project"), Kilim.button("Sync")] of Widget,
      padding: 8, spacing: 8, sizing: Kilim.fixed(220))
    middle = Kilim.column([@search, Kilim.scroll(@tasks), Kilim.button("New task")] of Widget,
      padding: 8, spacing: 8, sizing: Kilim.fixed(380))
    @editor = Kilim.column([@title_slot, Kilim.row([@status] of Widget), @labels_slot, @notes, Kilim.row([Kilim.button("Delete")] of Widget)] of Widget,
      spacing: 8, sizing: Kilim.fill)
    # Without a task there is nothing to type into: text typed there would have nowhere to go.
    @no_task = Kilim.label("No task selected")
    @right = Kilim.column([@editor] of Widget, padding: 8, sizing: Kilim.fill)
    body = Kilim.row([left, middle, @right] of Widget, sizing: Kilim.fill)
    @root = Kilim.column([body, Kilim.row([@status_line] of Widget, padding: 8)] of Widget)
    hook.app = self
    @projects.on_select = ->(i : Int32) { select_project(@projects.rows[i].key); nil }
    @tasks.on_select = ->(i : Int32) { select_task(@tasks.rows[i].key); nil }
    @status.on_change = ->(_i : Int32) { status_changed; nil }
    refresh
    show_task
    errs = @store.errors
    say(errs.empty? ? @store.root : "Could not read: " + errs.join(", "))
  end

  pub def current_project : Project?
    @store.projects.find { |p| p.key == @project }
  end

  pub def current_task : Task?
    if id = @task
      return @store.find(id)
    end
    nil
  end

  pub def select_project(key : String) : Nil
    return if key == @project
    flush
    if @dirty
      mark
      return
    end
    @project = key
    @task = nil
    refresh
    show_task
  end

  pub def select_task(id : String?) : Nil
    return if id == @task
    flush
    if @dirty
      mark
      return
    end
    @task = id
    mark
    show_task
  end

  pub def refresh : Nil
    @project = nil unless current_project
    @projects.rows = @store.projects.map { |p| ListRow.new(p.name, "", false, p.key) }
    rows = [] of ListRow
    if key = @project
      list = @store.tasks(key)
      STATUSES.each do |st|
        group = list.select { |t| t.status == st }
        rows << ListRow.new(status_title(st) + " (" + group.size.to_s + ")", "", true)
        group.each { |t| rows << ListRow.new(t.title, detail(t), false, t.id) }
      end
    end
    @tasks.rows = rows
    unless rows.any? { |r| !r.header && r.key == @task }
      @task = nil
      @dirty = false
      show_task
    end
    mark
  end

  pub def flush : Nil
    if (w = @win) && (id = @timer)
      w.cancel_timer(id)
    end
    @timer = nil
    return unless @dirty
    t = current_task
    unless t
      @dirty = false
      return
    end
    unless t.github?
      # an emptied title keeps the old one: a task file needs a title
      t.title = @title.text unless @title.text.strip.empty?
      t.labels = @labels.text.split(",").map(&.strip).reject(&.empty?)
    end
    t.status = STATUSES[@status.selected]
    t.notes = @notes.text
    if err = @store.save(t)
      say("Not saved: " + err + ". Retrying on the next edit.")
      return
    end
    @dirty = false
    refresh
  end

  pub def say(s : String) : Nil
    @status_line.text = s
  end

  # A text field changed: save once the typing pauses.
  def edited : Nil
    return unless @task
    @dirty = true
    if w = @win
      if id = @timer
        w.cancel_timer(id)
      end
      @timer = w.after(AUTOSAVE_MS) { flush }
    end
  end

  def status_changed : Nil
    return unless @task
    @dirty = true
    flush
  end

  # Both lists show @project and @task as selected.
  def mark : Nil
    @projects.selected = @projects.rows.index { |r| r.key == @project }
    @tasks.selected = @tasks.rows.index { |r| !r.header && r.key == @task }
  end

  # Fills the right pane from the current task; GitHub owns a GitHub task's title and labels.
  def show_task : Nil
    t = current_task
    swap(@right, t ? @editor : @no_task)
    gh = t ? t.github? : false
    swap(@title_slot, gh ? @title_ro : @title)
    swap(@labels_slot, gh ? @labels_ro : @labels)
    title = t ? t.title : ""
    labels = t ? t.labels.join(", ") : ""
    @title.text = title
    @title_ro.text = title
    @labels.text = labels
    @labels_ro.text = labels
    @status.selected = t ? (STATUSES.index(t.status) || 0) : 0
    @notes.text = t ? t.notes : ""
  end

  def swap(slot : Box, w : Widget) : Nil
    return if slot.children.includes?(w)
    slot.clear
    slot.add(w)
  end

  def detail(t : Task) : String
    d = t.labels.join(", ")
    if g = t.github
      n = "#" + g.split("#").last
      d = d.empty? ? n : d + " · " + n
    end
    d
  end
end
