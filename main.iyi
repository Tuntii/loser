module main

import std/env::{ENV}
import std/file::{File}
import std/dir::{Dir}
import loser/console
import loser/paths
import loser/mcp
import loser/sync
import loser/testkit
import loser/changes
import loser/store::{Store}
import loser/task::{Task, render_task}
import std/time::{Time}
import loser/gui/app::{App}
import loser/gui/forms::{new_project_form}
import github.com/tuntii/kilim
import github.com/tuntii/kilim/kilim/widget::{Widget}
import github.com/tuntii/kilim/kilim/window::{Window}
import github.com/tuntii/kilim/kilim/list_view::{ListView}
import github.com/tuntii/kilim/kilim/event::*

def fail(why : String) : NoReturn
  puts "loser selftest FAIL: " + why
  exit 1
end

def click(win : Window, w : Widget) : Nil
  win.step
  x = w.bounds.x + w.bounds.w / 2
  y = w.bounds.y + w.bounds.h / 2
  win.inject MouseDown.new(x, y, MouseButton::Left)
  win.inject MouseUp.new(x, y, MouseButton::Left)
end

# Selects the row with this key the way the keyboard does: focus the list, then Up/Down.
def choose(win : Window, list : ListView, key : String) : Nil
  want = list.rows.index { |r| !r.header && r.key == key } || fail("no row " + key)
  win.step
  win.ui.focus(list)
  (list.rows.size + 1).times do
    cur = list.selected
    break if cur == want
    win.inject KeyDown.new((c = cur) && c > want ? Key::Up : Key::Down, Mods.new)
  end
  fail("could not select row " + key) unless list.selected == want
end

def editors?(app : App) : Bool
  app.notes.attached_to?(app.root) || app.title.attached_to?(app.root) || app.title_ro.attached_to?(app.root)
end

def row_key(app : App, title : String) : String
  r = app.tasks.rows.find { |x| !x.header && x.title == title } || fail("no task row " + title.inspect)
  r.key
end

def task_path(id : String) : String
  key = id.starts_with?("beta-") ? "beta" : "alpha"
  Loser::Paths.root + "/" + key + "/" + id + ".md"
end

def file_of(id : String) : String
  File.read(task_path(id))
end

def press(win : Window, k : Key) : Nil
  win.inject KeyDown.new(k, Mods.new)
end

def ctrl(win : Window, k : Key) : Nil
  win.inject KeyDown.new(k, Mods.new(primary: true))
end

def titles(app : App) : Array(String)
  app.tasks.rows.reject(&.header).map(&.title)
end

# What the worker would post: the root as it is now on disk.
def outside(app : App) : Nil
  app.on_message("scan\n" + Loser::Changes.scan(Loser::Paths.root))
end

# Steps the window until the status line reads `text` (answers from the worker come through the inbox).
def wait_status(win : Window, app : App, text : String) : Nil
  waited = 0
  while app.status_line.text != text
    fail("status line is " + app.status_line.text.inspect + ", waited 5 s for " + text.inspect) if waited >= 5000
    sleep(20)
    waited += 20
    win.step
  end
end

NO_REPO = "GitHub: no project is linked to a repo"

def seed(root : String) : Nil
  st = Store.new(root)
  st.load
  fail("add Alpha") if st.add_project("Alpha", nil).is_a?(String)
  # no repo: the worker's syncs must not reach the real GitHub
  fail("add Beta") if st.add_project("Beta", nil).is_a?(String)
  fail("create") if st.create("alpha", "Write the spec", "first notes", "todo", ["docs"]).is_a?(String)
  fail("create") if st.create("alpha", "Build the window", "", "doing", ["gui", "kilim"]).is_a?(String)
  fail("create") if st.create("alpha", "Ship v0.1.0", "", "done").is_a?(String)
  gh = Task.new("beta-12", "Crash on start")
  gh.labels = ["bug"]
  gh.github = "Tuntii/loser#12"
  gh.github_kind = "issue"
  gh.github_state = "open"
  if err = st.save(gh)
    fail(err)
  end
end

def selftest(win : Window, app : App, bmp : String) : Nil
  # The worker syncs once at startup and answers through the inbox.
  wait_status(win, app, NO_REPO)

  # No task selected: no editors to type into.
  win.step
  fail("editors shown without a task") if editors?(app)
  fail("no-task label missing") unless app.no_task.attached_to?(app.root)

  # Project click: three headers, three tasks.
  p = app.projects
  win.inject MouseDown.new(p.bounds.x + 20, p.bounds.y + 4, MouseButton::Left)
  win.inject MouseUp.new(p.bounds.x + 20, p.bounds.y + 4, MouseButton::Left)
  fail("Alpha not selected") unless (cp = app.current_project) && cp.key == "alpha"
  heads = app.tasks.rows.select(&.header).map(&.title)
  fail("headers: " + heads.inspect) unless heads == ["To do (1)", "Doing (1)", "Done (1)"]
  fail("task rows: " + app.tasks.rows.size.to_s) unless app.tasks.rows.size == 6
  fail("detail: " + app.tasks.rows[3].detail.inspect) unless app.tasks.rows[3].detail == "gui, kilim"
  fail("editors shown after a project click") if editors?(app)

  # Task selection fills the right pane.
  id = row_key(app, "Write the spec")
  choose(win, app.tasks, id)
  fail("editors missing with a task") unless editors?(app) && !app.no_task.attached_to?(app.root)
  fail("title field: " + app.title.text.inspect) unless app.title.text == "Write the spec"
  fail("notes field: " + app.notes.text.inspect) unless app.notes.text == "first notes"
  fail("labels field: " + app.labels.text.inspect) unless app.labels.text == "docs"
  fail("local title is not a Textbox") unless app.title.attached_to?(app.root) && !app.title_ro.attached_to?(app.root)

  # Typing autosaves 500 ms after the last change: each keystroke restarts the wait.
  click(win, app.notes)
  win.inject TextInput.new("çğış ")
  sleep(300)
  win.step
  win.inject TextInput.new("typed. ")
  sleep(300)
  win.step
  fail("saved 300 ms after the last change") if file_of(id).includes?("çğış")
  sleep(350)
  win.step
  fail("autosave did not write the notes:\n" + file_of(id)) unless file_of(id).includes?("çğış typed.")

  # Status saves at once and moves the row under Done.
  click(win, app.status)
  win.inject KeyDown.new(Key::Down, Mods.new)
  win.inject KeyDown.new(Key::Down, Mods.new)
  win.inject KeyDown.new(Key::Enter, Mods.new)
  fail("status not saved:\n" + file_of(id)) unless file_of(id).includes?("status: \"done\"")
  rows = app.tasks.rows
  done_at = rows.index { |r| r.header && r.title.starts_with?("Done") } || fail("no Done header")
  at = rows.index { |r| r.key == id } || fail("row gone")
  fail("row not under Done") unless at > done_at
  fail("selection lost after the move") unless app.tasks.selected == at
  fail("headers after move: " + rows.select(&.header).map(&.title).inspect) unless rows[0].title == "To do (0)"

  # Switching project saves pending edits first.
  click(win, app.notes)
  win.inject TextInput.new("switch ")
  choose(win, app.projects, "beta")
  fail("switch did not save:\n" + file_of(id)) unless file_of(id).includes?("switch ")
  fail("editors shown after switching project") if editors?(app)

  # A GitHub task: title and labels read-only.
  choose(win, app.tasks, "beta-12")
  fail("GitHub title shows a Textbox") if app.title.attached_to?(app.root)
  fail("GitHub title Label missing") unless app.title_ro.attached_to?(app.root) && app.title_ro.text == "Crash on start"
  fail("GitHub labels") unless app.labels_ro.attached_to?(app.root) && app.labels_ro.text == "bug" && !app.labels.attached_to?(app.root)
  fail("GitHub detail: " + app.tasks.rows[1].detail.inspect) unless app.tasks.rows[1].detail == "bug · #12"

  # The close path: flush right after typing, no waiting.
  click(win, app.notes)
  win.inject TextInput.new("closing")
  # The hidden Textboxes must never reach a GitHub task's file.
  app.title.text = "X"
  app.labels.text = "X"
  app.flush
  f = file_of("beta-12")
  fail("flush did not write:\n" + f) unless f.includes?("closing")
  fail("GitHub title changed:\n" + f) unless f.includes?("title: \"Crash on start\"")
  fail("GitHub labels changed:\n" + f) unless f.includes?("labels: [\"bug\"]")

  # Tab walks the panes in widget tree order, the buttons included.
  choose(win, app.projects, "alpha")
  choose(win, app.tasks, row_key(app, "Build the window"))
  order = [app.projects, app.new_project_button, app.sync_button, app.search, app.tasks, app.new_task_button,
           app.title, app.status, app.labels, app.notes, app.delete_button] of Widget
  win.ui.focus(nil)
  order.each_with_index do |w, i|
    press(win, Key::Tab)
    fail("Tab " + (i + 1).to_s + " did not reach widget " + i.to_s + " of the order") unless win.ui.focused == w
  end

  # Ctrl+N: a new task, its title focused and selected, so typing replaces it.
  ctrl(win, Key::N)
  nt = app.current_task || fail("Ctrl+N selected no task")
  new_id = nt.id
  fail("new task title " + nt.title.inspect) unless nt.title == "New task"
  fail("title not focused after Ctrl+N") unless win.ui.focused == app.title
  win.inject TextInput.new("Plan the release")
  fail("title field after typing: " + app.title.text.inspect) unless app.title.text == "Plan the release"
  sleep(550)
  win.step
  fail("new title not saved:\n" + file_of(new_id)) unless file_of(new_id).includes?("title: \"Plan the release\"")

  # Ctrl+F: search narrows the list; clearing it shows everything again.
  ctrl(win, Key::F)
  fail("search not focused after Ctrl+F") unless win.ui.focused == app.search
  win.inject TextInput.new("spec")
  # the selected task keeps its row even when it does not match
  fail("search rows: " + titles(app).inspect) unless titles(app) == ["Plan the release", "Write the spec"]

  # Editing the selected task until it stops matching keeps it selected, its editors and focus in place.
  choose(win, app.tasks, id)
  click(win, app.title)
  ctrl(win, Key::A)
  win.inject TextInput.new("Write the plan")
  sleep(550)
  win.step
  fail("retitle not saved:\n" + file_of(id)) unless file_of(id).includes?("title: \"Write the plan\"")
  fail("task deselected by the search") unless (ct = app.current_task) && ct.id == id
  fail("editors gone under the search") unless app.title.attached_to?(app.root)
  fail("focus left the title field") unless win.ui.focused == app.title

  ctrl(win, Key::F)
  ctrl(win, Key::A)
  press(win, Key::Backspace)
  fail("rows after clearing the search: " + titles(app).inspect) unless titles(app).size == 4

  # Delete with the task list focused asks first; Enter confirms and the file goes.
  choose(win, app.tasks, new_id)
  press(win, Key::Delete)
  fail("Delete did not ask") unless win.ui.modal
  press(win, Key::Enter)
  fail("confirm dialog still open") if win.ui.modal
  fail("task file still there") if File.exists?(task_path(new_id))
  fail("deleted row still listed") if app.tasks.rows.any? { |r| r.key == new_id }
  fail("focus not on the task list after Delete") unless win.ui.focused == app.tasks

  # Delete inside the notes deletes a character, not the task.
  choose(win, app.tasks, row_key(app, "Build the window"))
  click(win, app.notes)
  win.inject TextInput.new("xy")
  press(win, Key::Left)
  press(win, Key::Delete)
  fail("Delete in the notes opened a dialog") if win.ui.modal
  fail("notes after Delete: " + app.notes.text.inspect) unless app.notes.text == "x"
  app.flush

  # Sync through the worker (spawn_parallel, then the inbox): no project is linked to a repo.
  app.say("")
  click(win, app.sync_button)
  wait_status(win, app, NO_REPO)

  # New project: an invalid repo is refused, a valid one creates and selects the project.
  toml = Loser::Paths.root + "/projects.toml"
  click(win, app.new_project_button)
  fail("no New project form") unless win.ui.modal
  win.inject TextInput.new("Gamma")
  press(win, Key::Tab)
  win.inject TextInput.new("not a repo")
  press(win, Key::Enter)
  fail("invalid repo, status line: " + app.status_line.text.inspect) unless app.status_line.text.includes?("invalid repo")
  fail("form closed on an invalid repo") unless win.ui.modal
  fail("project created with an invalid repo") if File.read(toml).includes?("Gamma")
  ctrl(win, Key::A)
  win.inject TextInput.new("Tuntii/loser")
  press(win, Key::Enter)
  fail("form still open after Create") if win.ui.modal
  fail("Gamma not selected") unless (gp = app.current_project) && gp.key == "gamma" && gp.repo == "Tuntii/loser"
  fail("Gamma not in projects.toml:\n" + File.read(toml)) unless File.read(toml).includes?("Tuntii/loser")

  # An outside append to the notes of the task being edited joins the editor's text and is saved.
  choose(win, app.projects, "alpha")
  choose(win, app.tasks, id)
  click(win, app.notes)
  press(win, Key::End)
  win.inject TextInput.new(" mine")
  mine = app.notes.text
  Loser::Paths.write_atomic(task_path(id), file_of(id) + "outside line\n")
  outside(app)
  fail("append not merged: " + app.notes.text.inspect) unless app.notes.text == mine + "outside line\n"
  fail("merged notes not saved:\n" + file_of(id)) unless file_of(id).ends_with?(mine + "outside line\n")

  # Both sides rewrote the notes: mine is saved, the outside version goes to a conflict file.
  # (the merge set the notes anew, so the caret is at the start: compare whole texts)
  win.inject TextInput.new("again")
  mine = app.notes.text
  text = file_of(id)
  cut = text.index("\n---\n") || fail("no front matter end")
  Loser::Paths.write_atomic(task_path(id), text[0, cut + 5] + "rewritten outside\n")
  outside(app)
  fail("conflict, status line: " + app.status_line.text.inspect) unless app.status_line.text.starts_with?("Saved your text; the other version is in " + id + ".conflict-")
  fail("conflict lost my text:\n" + file_of(id)) unless file_of(id).ends_with?("\n---\n" + mine) && app.notes.text == mine
  dir = Loser::Paths.root + "/alpha"
  kept = Dir.children(dir).find { |n| n.includes?(".conflict-") } || fail("no conflict file")
  fail("conflict file: " + File.read(dir + "/" + kept)) unless File.read(dir + "/" + kept).ends_with?("rewritten outside\n")

  # The task being edited is deleted outside: unsaved text is written back.
  win.inject TextInput.new(" kept")
  mine = app.notes.text
  File.delete(task_path(id))
  outside(app)
  fail("unsaved text not written back") unless File.exists?(task_path(id)) && file_of(id).ends_with?("\n---\n" + mine)
  fail("deleted outside, status line: " + app.status_line.text.inspect) unless app.status_line.text.includes?("deleted")

  # Deleted outside without unsaved changes: deselected, focus back on the list.
  click(win, app.notes)
  File.delete(task_path(id))
  outside(app)
  fail("deleted task still selected") if app.current_task
  fail("editors shown for a deleted task") if editors?(app)
  fail("focus not on the task list after an outside delete") unless win.ui.focused == app.tasks

  # An outside rewrite of a task not being edited shows in the list.
  ship = row_key(app, "Ship v0.1.0")
  Loser::Paths.write_atomic(task_path(ship), file_of(ship).gsub("title: \"Ship v0.1.0\"", "title: \"Ship it now\""))
  outside(app)
  fail("outside title not shown: " + titles(app).inspect) unless titles(app).includes?("Ship it now")

  # An outside edit of projects.toml adding a project shows it on the left.
  Loser::Paths.write_atomic(toml, File.read(toml) + "\n[[project]]\nkey = \"delta\"\nname = \"Delta\"\n")
  outside(app)
  fail("Delta not listed: " + app.projects.rows.map(&.title).inspect) unless app.projects.rows.any? { |r| r.title == "Delta" }

  # A sync summary goes to the status line.
  app.on_message("sync\nGitHub: not logged in (run gh auth login)")
  fail("sync summary not shown: " + app.status_line.text.inspect) unless app.status_line.text == "GitHub: not logged in (run gh auth login)"

  # A git pull of 200 new files plus the selected task: reloaded in slices across frames, the selected task first.
  bw = row_key(app, "Build the window")
  choose(win, app.tasks, bw)
  200.times do |i|
    t = Task.new("alpha-bulk" + (1000 + i).to_s, "Pulled " + i.to_s)
    t.notes = "from a pull\n"
    Loser::Paths.write_atomic(Loser::Paths.root + "/alpha/" + t.id + ".md", render_task(t))
  end
  Loser::Paths.write_atomic(task_path(bw), file_of(bw) + "\npulled too")
  scanned = "scan\n" + Loser::Changes.scan(Loser::Paths.root)
  t0 = Time.monotonic
  app.on_message(scanned)
  first = (Time.monotonic - t0).total_milliseconds
  fail("selected task not in the first slice: " + app.notes.text.inspect) unless app.notes.text.ends_with?("\npulled too")
  worst = 0.0
  steps = 1
  while app.pending?
    fail("bulk reload never finished") if steps > 2000
    sleep(2)
    t1 = Time.monotonic
    win.step
    took = (Time.monotonic - t1).total_milliseconds
    worst = took if took > worst
    steps += 1
  end
  puts "200 outside files: first pass " + first.round(1).to_s + " ms, worst later frame " + worst.round(1).to_s + " ms, " + steps.to_s + " window steps"
  # loose bounds so CI machines pass; the printed numbers are the measurement
  fail("a reload pass took over 100 ms") if first > 100 || worst > 100
  fail("200 pulled tasks not listed: " + titles(app).size.to_s) unless titles(app).size == 202

  win.step
  win.screenshot(bmp)
  fail("no screenshot") unless File.exists?(bmp)
  win.close
  puts "loser selftest: ok"
end

cmd = Program.args.first?
if cmd == "mcp"
  exit Loser::Mcp.serve(Loser::Paths.root)
end
if cmd == "sync"
  summary = Loser::Sync.run_sync(Loser::Paths.root, Program.args[1]?)
  puts summary
  # every failure text from gh_issues, the lock and the empty case, differs from a success by what follows "GitHub: "
  exit(summary.includes?(" new, ") && !summary.includes?("; ") ? 0 : 1)
end

Loser::Console.detach_if_owned unless ENV["LOSER_SELFTEST"]?
bmp = ENV["LOSER_SELFTEST"]?
if bmp
  # never the real ~/loser
  home = Loser::Testkit.temp_root("selftest")
  seed(home)
  ENV["LOSER_HOME"] = home
end
store = Store.new(Loser::Paths.root)
store.load
app = App.new(store)
win = Kilim.window("loser", 1100, 700, app.root)
worker = app.attach(win)
app.on_new_project = -> { win.ui.show_modal(new_project_form(app)); nil }
# The group joins the worker once the window is gone.
group do |g|
  g.spawn_parallel { worker.run; nil }
  if bmp
    selftest(win, app, bmp)
  else
    win.run
    app.flush
    # the window is gone: the status line's message is the only trace of a failed last save
    STDERR.puts "loser: " + app.status_line.text if app.dirty
  end
  worker.stop
end
